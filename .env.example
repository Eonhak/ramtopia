# Server: use a persistent directory in production.
PORT=8080
DATABASE_PATH=./data/ramtopia.sqlite
# Required in production, e.g. https://game.example.com
APP_ORIGIN=
# Optional: comma-separated external frontend origins.
ALLOWED_ORIGINS=
# Frontend: empty uses same-origin /api (recommended).
# For GitHub Pages: your public HTTPS API server URL, then rebuild.
VITE_API_BASE_URL=
