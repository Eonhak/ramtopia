{
  "name": "ramtopia",
  "version": "1.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --base=./",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/rules.test.js tests/server.test.js && node tests/browser.cjs && node tests/auth-browser.cjs",
    "server": "node --env-file-if-exists=.env server/app.js",
    "start": "node server/app.js",
    "test:server": "node --test tests/server.test.js"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
